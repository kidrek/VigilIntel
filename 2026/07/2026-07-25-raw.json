af_files/OT/white/2026/icsa-26-204-03.json', 'https://www.cisa.gov/news-events/ics-advisories/icsa-26-204-03'], 'vulnerability': ['CVE-2026-61892']}}, {'title': 'CVE-2026-60134 - Weintek cMT3092X Reliance on Cookies without Validation and Integrity Checking in a Security Decision', 'publication_date': 'Fri, 24 Jul 2026 23:16:50 +0000', 'source': 'https://cvefeed.io/vuln/detail/CVE-2026-60134', 'source_type': "['']", 'source_level': 2, 'text': ['The following products are affected byCVE-2026-60134vulnerability. Even ifcvefeed.iois aware of the exact versions of the products that are affected, the information is not represented in the table below.', 'Common Attack Pattern Enumeration and Classification (CAPEC) stores attack patterns, which are descriptions of the common attributes and approaches employed by adversaries to exploit theCVE-2026-60134weaknesses.', 'We scan GitHub repositories to detect new proof-of-concept exploits. Following list is a collection of public exploits and proof-of-concepts, which have been published on GitHub (sorted by the most recently updated).', "Vulnerability history details can be useful for understanding the evolution of a vulnerability, and for identifying the most recent changes that may impact the vulnerability's severity, exploitability, or other characteristics."], 'observables': {'domain-name': ['cisa.gov', 'cvefeed.io'], 'email-addr': ['ics-cert@hq.dhs.gov'], 'url': ['http://www.cisa.gov/news-events/ics-advisories/icsa-26-204-03', 'https://dl.weintek.com/public/Document/TEC/TEC25003E_cMT_EasyWeb_V2_Security_Issues.pdf', 'https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-204-03.json', 'https://www.cisa.gov/news-events/ics-advisories/icsa-26-204-03'], 'vulnerability': ['CVE-2026-60134']}}, {'title': 'CVE-2026-61884 - Tycon Systems TPDIN-Monitor-WEB2 Authentication Bypass Using an Alternate Path or Channel', 'publication_date': 'Fri, 24 Jul 2026 22:16:50 +0000', 'source': 'https://cvefeed.io/vuln/detail/CVE-2026-61884', 'source_type': "['']", 'source_level': 2, 'text': ['The web management interface of Tycon Systems TPDIN-Monitor-WEB2 does not perform server-side validation of credentials during the login process. By submitting empty values for both credential fields, an unauthenticated remote attacker can bypass the authentication check and establish a valid administrative session. This grants full access to device controls including power relay management, device reboot, remote access service configuration, and network settings, which could allow an attacker to disrupt connected infrastructure or cause physical damage to equipment.', 'The following products are affected byCVE-2026-61884vulnerability. Even ifcvefeed.iois aware of the exact versions of the products that are affected, the information is not represented in the table below.', 'Common Attack Pattern Enumeration and Classification (CAPEC) stores attack patterns, which are descriptions of the common attributes and approaches employed by adversaries to exploit theCVE-2026-61884weaknesses.', 'We scan GitHub repositories to detect new proof-of-concept exploits. Following list is a collection of public exploits and proof-of-concepts, which have been published on GitHub (sorted by the most recently updated).', "Vulnerability history details can be useful for understanding the evolution of a vulnerability, and for identifying the most recent changes that may impact the vulnerability's severity, exploitability, or other characteristics."], 'observables': {'domain-name': ['cisa.gov', 'cvefeed.io', 'tyconsystems.com'], 'email-addr': ['ics-cert@hq.dhs.gov'], 'url': ['http://www.cisa.gov/news-events/ics-advisories/icsa-26-202-01', 'http://www.tyconsystems.com/contact', 'https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-202-01.json', 'https://www.cisa.gov/news-events/ics-advisories/icsa-26-202-01', 'https://www.tyconsystems.com/contact'], 'vulnerability': ['CVE-2026-61884']}}, {'title': 'CVE-2026-66041 - FFmpeg 7.0 - 8.1.2 Heap Out-of-Bounds Write via vf_quirc Filter', 'publication_date': 'Fri, 24 Jul 2026 20:18:21 +0000', 'source': 'https://cvefeed.io/vuln/detail/CVE-2026-66041', 'source_type': "['']", 'source_level': 2, 'text': ['FFmpeg 7.0 through 8.1.2, fixed in commit 4da9812, contains a heap out-of-bounds write vulnerability in the vf_quirc filter that allows an attacker to corrupt heap memory by supplying a crafted PGS/SUP subtitle file with mismatched frame dimensions. Attackers can provide a subtitle file whose second presentation has larger dimensions than its first, causing av_image_copy_plane() to copy data exceeding the initial allocation size into the undersized libquirc grayscale image buffer, resulting in heap corruption and process crash with potential for code execution.', 'The following products are affected byCVE-2026-66041vulnerability. Even ifcvefeed.iois aware of the exact versions of the products that are affected, the information is not represented in the table below.', 'Common Attack Pattern Enumeration and Classification (CAPEC) stores attack patterns, which are descriptions of the common attributes and approaches employed by adversaries to exploit theCVE-2026-66041weaknesses.', 'We scan GitHub repositories to detect new proof-of-concept exploits. Following list is a collection of public exploits and proof-of-concepts, which have been published on GitHub (sorted by the most recently updated).', "Vulnerability history details can be useful for understanding the evolution of a vulnerability, and for identifying the most recent changes that may impact the vulnerability's severity, exploitability, or other characteristics."], 'observables': {'domain-name': ['cvefeed.io'], 'email-addr': ['disclosure@vulncheck.com'], 'file': [{'hash_type': 'SHA-1', 'values': ['4da9812e25894fb51d62a8875cfa8eb39b5e20f5']}], 'url': ['http://www.vulncheck.com/advisories/ffmpeg-heap-out-of-bounds-write-via-vf-quirc-filter', 'https://code.ffmpeg.org/FFmpeg/FFmpeg', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/commit/4da9812e25894fb51d62a8875cfa8eb39b5e20f5', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/23625', 'https://www.vulncheck.com/advisories/ffmpeg-heap-out-of-bounds-write-via-vf-quirc-filter'], 'vulnerability': ['CVE-2026-66041']}}, {'title': 'CVE-2026-66040 - FFmpeg Heap Out-of-Bounds Write via PNG/APNG eXIf Encoder', 'publication_date': 'Fri, 24 Jul 2026 20:18:21 +0000', 'source': 'https://cvefeed.io/vuln/detail/CVE-2026-66040', 'source_type': "['']", 'source_level': 2, 'text': ['FFmpeg through 8.1.2, fixed in commit b506faf, contains a heap out-of-bounds write vulnerability in the native PNG and APNG encoders that allows remote attackers to corrupt heap memory by supplying a crafted PNG image with a malicious eXIf chunk. Attackers can craft an eXIf chunk where multiple IFD entries reference the same large value payload, causing canonical serialization to expand the output far beyond the undersized allocation estimated by add_exif_profile_size(), resulting in png_write_chunk() writing tens of thousands of bytes past the buffer boundary, leading to deterministic heap corruption, process crash, and potentially arbitrary code execution.', 'The following products are affected byCVE-2026-66040vulnerability. Even ifcvefeed.iois aware of the exact versions of the products that are affected, the information is not represented in the table below.', 'Common Attack Pattern Enumeration and Classification (CAPEC) stores attack patterns, which are descriptions of the common attributes and approaches employed by adversaries to exploit theCVE-2026-66040weaknesses.', 'We scan GitHub repositories to detect new proof-of-concept exploits. Following list is a collection of public exploits and proof-of-concepts, which have been published on GitHub (sorted by the most recently updated).', "Vulnerability history details can be useful for understanding the evolution of a vulnerability, and for identifying the most recent changes that may impact the vulnerability's severity, exploitability, or other characteristics."], 'observables': {'domain-name': ['cvefeed.io'], 'email-addr': ['disclosure@vulncheck.com'], 'file': [{'hash_type': 'SHA-1', 'values': ['b506fafec9a19fcbc2be5271875fd4a63d6615bc']}], 'url': ['http://www.vulncheck.com/advisories/ffmpeg-heap-out-of-bounds-write-via-png-apng-exif-encoder', 'https://code.ffmpeg.org/FFmpeg/FFmpeg', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/commit/b506fafec9a19fcbc2be5271875fd4a63d6615bc', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/23786', 'https://www.vulncheck.com/advisories/ffmpeg-heap-out-of-bounds-write-via-png-apng-exif-encoder'], 'vulnerability': ['CVE-2026-66040']}}, {'title': 'CVE-2026-66039 - FFmpeg MACE6 Audio Decoder Heap Out-of-Bounds Write via CAF File', 'publication_date': 'Fri, 24 Jul 2026 20:18:20 +0000', 'source': 'https://cvefeed.io/vuln/detail/CVE-2026-66039', 'source_type': "['']", 'source_level': 2, 'text': ['FFmpeg through 8.1.2, fixed in commit aafb5c6, contains a signed integer overflow vulnerability in the MACE6 audio decoder that allows attackers to corrupt heap memory by supplying a crafted CAF file with a malicious bytes_per_packet value. Attackers can craft a CAF file with oversized bytes_per_packet and frames_per_packet values in the desc chunk to trigger an integer overflow in mace_decode_frame() during output sample count computation, resulting in an undersized buffer allocation and heap out-of-bounds write that could enable code execution.', 'The following products are affected byCVE-2026-66039vulnerability. Even ifcvefeed.iois aware of the exact versions of the products that are affected, the information is not represented in the table below.', 'Common Attack Pattern Enumeration and Classification (CAPEC) stores attack patterns, which are descriptions of the common attributes and approaches employed by adversaries to exploit theCVE-2026-66039weaknesses.', 'We scan GitHub repositories to detect new proof-of-concept exploits. Following list is a collection of public exploits and proof-of-concepts, which have been published on GitHub (sorted by the most recently updated).', "Vulnerability history details can be useful for understanding the evolution of a vulnerability, and for identifying the most recent changes that may impact the vulnerability's severity, exploitability, or other characteristics."], 'observables': {'domain-name': ['cvefeed.io'], 'email-addr': ['disclosure@vulncheck.com'], 'file': [{'hash_type': 'SHA-1', 'values': ['aafb5c655edc76a753275c383ebb139feb032718']}], 'url': ['http://www.vulncheck.com/advisories/ffmpeg-mace6-audio-decoder-heap-out-of-bounds-write-via-caf-file', 'https://code.ffmpeg.org/FFmpeg/FFmpeg', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/commit/aafb5c655edc76a753275c383ebb139feb032718', 'https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/23631', 'https://www.vulncheck.com/advisories/ffmpeg-mace6-audio-decoder-heap-out-of-bounds-write-via-caf-file'], 'vulnerability': ['CVE-2026-66039']}}, {'title': 'Multiples vulnérabilités dans MongoDB (24 juillet 2026)', 'publication_date': 'Fri, 24 Jul 2026 00:00:00 +0000', 'source': 'https://www.cert.ssi.gouv.fr/avis/CERTFR-2026-AVI-0922/', 'source_type': "['operational', 'vulnerabilities']", 'source_level': 1, 'text': ["De multiples vulnérabilités ont été découvertes dans MongoDB. Elles permettent à un attaquant de provoquer un contournement de la politique de sécurité, un déni de service et un problème de sécurité non spécifié par l'éditeur."], 'observables': {'domain-name': ['cve.org'], 'url': ['http://www.cve.org/CVERecord?id=CVE-2026-13055', 'http://www.cve.org/CVERecord?id=CVE-2026-13056', 'http://www.cve.org/CVERecord?id=CVE-2026-13057', 'http://www.cve.org/CVERecord?id=CVE-2026-13058', 'http://www.cve.org/CVERecord?id=CVE-2026-13059', 'http://www.cve.org/CVERecord?id=CVE-2026-13060', 'http://www.cve.org/CVERecord?id=CVE-2026-13061', 'http://www.cve.org/CVERecord?id=CVE-2026-13062', 'http://www.cve.org/CVERecord?id=CVE